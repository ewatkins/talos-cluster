{
  "uid": "minecraft-security",
  "title": "Security",
  "tags": [
    "minecraft",
    "oci",
    "security"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 2,
      "type": "table",
      "title": "SSH and Sudo",
      "description": "auth.log on the minecraft-relay VM without the Oracle Cloud Agent's own sudo calls: SSH logins and sudo.",
      "datasource": {
        "type": "oci-logs-datasource",
        "uid": "oci-logs"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oci-logs-datasource",
            "uid": "oci-logs"
          },
          "tenancy": "DEFAULT/",
          "region": "us-chicago-1",
          "searchQuery": "search \"{{ .compartment }}/ocid1.loggroup.oc1.us-chicago-1.amaaaaaazjfsi5aa2fqxnvwfcischkgombkdvjsrfvjite53ck3jo4vwqg6a/ocid1.log.oc1.us-chicago-1.amaaaaaazjfsi5aa2oq4c34dzvuazr4hu6iku6ntnj3b4rjtemlyysmskxvq\" | where data.tailed_path = '/var/log/auth.log' | sort by datetime desc"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "data",
            "format": "json"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "message",
            "format": "regexp",
            "regExp": "/^\\S+ \\S+ (?<Process>[^\\[:]+)(?:\\[\\d+\\])?: (?<Event>.*)$/"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "message",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "snap_daemon|by \\(uid=584788\\)|session (opened|closed) for user root"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "timestamp",
                "Process",
                "Event"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "timestamp": "Time"
            },
            "indexByName": {
              "timestamp": 0,
              "Process": 1,
              "Event": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Process"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      }
    },
