{
  "uid": "minecraft-relay",
  "title": "Analytics",
  "tags": [
    "minecraft",
    "oci",
    "analytics"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Active Play Sessions",
      "description": "Players on the network right now: everyone whose latest Velocity event in the last 7 days is a login (Java and Bedrock).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(last_over_time({job=\"minecraft\", host=\"wing-proxy\"} |= \"[connected player]\" | regexp \"\\\\[connected player\\\\] (?P<player>\\\\S+) \\\\(/[\\\\d.]+:\\\\d+\\\\) has (?P<event>connected|disconnected)\" | event != \"\" | label_format online=`{{`{{`}} if eq (len .event) 9 }}1{{`{{`}} else }}0{{`{{`}} end }}` | unwrap online [7d]) by (player))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Play Sessions",
      "description": "Velocity logins in the selected range (Java and Bedrock).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"minecraft\", host=\"wing-proxy\"} |= \"[connected player]\" |= \") has connected\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Distinct Players",
      "description": "Distinct player names that logged in during the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "editorMode": "code",
          "expr": "count(sum by (player) (count_over_time({job=\"minecraft\", host=\"wing-proxy\"} |= \"[connected player]\" |= \") has connected\" | regexp \"\\\\[connected player\\\\] (?P<player>\\\\S+) \" [$__range])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Pings",
      "description": "Status pings under 50 KB: Gatus and server scanners.",
      "datasource": {
        "type": "oci-logs-datasource",
        "uid": "oci-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oci-logs-datasource",
            "uid": "oci-logs"
          },
          "tenancy": "DEFAULT/",
          "region": "us-chicago-1",
          "searchQuery": "search \"{{ .compartment }}/ocid1.loggroup.oc1.us-chicago-1.amaaaaaazjfsi5aa2fqxnvwfcischkgombkdvjsrfvjite53ck3jo4vwqg6a/ocid1.log.oc1.us-chicago-1.amaaaaaazjfsi5aa2oq4c34dzvuazr4hu6iku6ntnj3b4rjtemlyysmskxvq\" | where data.tailed_path = '/var/log/haproxy.log' | sort by datetime desc"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "data",
            "format": "json"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "message",
            "format": "regexp",
            "regExp": "/^\\S+ \\S+ (?:haproxy|bedrock-relay)\\[\\d+\\]: (?<Player>[\\d.]+):\\d+ \\[[^\\]]+\\] minecraft_(?<Edition>java|bedrock) \\S+ -?\\d+\\/(?<Connect>-?\\d+)\\/(?<Duration>-?\\d+) (?<Bytes>\\d+) (?<Ended>\\S+).*$/"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Connect",
                "destinationType": "number"
              },
              {
                "targetField": "Duration",
                "destinationType": "number"
              },
              {
                "targetField": "Bytes",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Bytes",
                "config": {
                  "id": "lower",
                  "options": {
                    "value": 50000
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^Player$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
