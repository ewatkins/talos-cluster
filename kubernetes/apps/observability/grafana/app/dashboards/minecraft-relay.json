    {
      "id": 2,
      "type": "table",
      "title": "SSH and sudo",
      "description": "auth.log without the Oracle Cloud Agent's own sudo calls.",
      "datasource": {
        "type": "oci-logs-datasource",
        "uid": "oci-logs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oci-logs-datasource",
            "uid": "oci-logs"
          },
          "tenancy": "DEFAULT/",
          "region": "us-chicago-1",
          "searchQuery": "search \"{{ .compartment }}/ocid1.loggroup.oc1.us-chicago-1.amaaaaaazjfsi5aa2fqxnvwfcischkgombkdvjsrfvjite53ck3jo4vwqg6a/ocid1.log.oc1.us-chicago-1.amaaaaaazjfsi5aa2oq4c34dzvuazr4hu6iku6ntnj3b4rjtemlyysmskxvq\" | where data.tailed_path = '/var/log/auth.log' | sort by datetime desc"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "data",
            "format": "json"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "message",
            "format": "regexp",
            "regExp": "/^\\S+ \\S+ (?<Process>[^\\[:]+)(?:\\[\\d+\\])?: (?<Event>.*)$/"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "message",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "snap_daemon|by \\(uid=584788\\)|session (opened|closed) for user root"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
