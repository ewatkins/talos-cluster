    {
      "id": 10,
      "type": "stat",
      "title": "Play sessions",
      "description": "Connections of 50 KB or more in the selected range.",
      "datasource": {
        "type": "oci-logs-datasource",
        "uid": "oci-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oci-logs-datasource",
            "uid": "oci-logs"
          },
          "tenancy": "DEFAULT/",
          "region": "us-chicago-1",
          "searchQuery": "search \"{{ .compartment }}/ocid1.loggroup.oc1.us-chicago-1.amaaaaaazjfsi5aa2fqxnvwfcischkgombkdvjsrfvjite53ck3jo4vwqg6a/ocid1.log.oc1.us-chicago-1.amaaaaaazjfsi5aa2oq4c34dzvuazr4hu6iku6ntnj3b4rjtemlyysmskxvq\" | where data.tailed_path = '/var/log/haproxy.log' | sort by datetime desc"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "data",
            "format": "json"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "message",
            "format": "regexp",
            "regExp": "/^\\S+ \\S+ haproxy\\[\\d+\\]: (?<Player>[\\d.]+):\\d+ \\[[^\\]]+\\] \\S+ \\S+ -?\\d+\\/(?<Connect>-?\\d+)\\/(?<Duration>-?\\d+) (?<Bytes>\\d+) (?<Ended>\\S+).*$/"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Connect",
                "destinationType": "number"
              },
              {
                "targetField": "Duration",
                "destinationType": "number"
              },
              {
                "targetField": "Bytes",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Bytes",
                "config": {
                  "id": "greaterOrEqual",
                  "options": {
                    "value": 50000
                  }
                }
              }
            ]
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "count"
            ],
            "fields": "^Player$",
            "mode": "reduceFields"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Player$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
