    {
      "id": 1,
      "type": "table",
      "title": "Play Sessions",
      "description": "Sessions from Velocity on wing-proxy (Java and Bedrock): one row per login, paired with its logout. Active means the player is still on. IPs are the real player addresses (PROXY protocol); Home is everyone at home; Work is the work network.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "expr": "{job=\"minecraft\", host=\"wing-proxy\"} |= \"[connected player]\" |= \") has connected\""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "expr": "{job=\"minecraft\", host=\"wing-proxy\"} |= \"[connected player]\" |~ \"\\\\) has disconnected\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "regexp",
            "regExp": "/\\[connected player\\] (?<Player>(?<Dot>\\.)?\\S+) \\(\\/(?<Addr>(?<IP>[\\d.]+):\\d+)\\) has connected$/"
          },
          "filter": {
            "id": "byRefId",
            "options": "A"
          }
        },
        {
          "id": "extractFields",
          "options": {
