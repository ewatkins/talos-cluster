#cloud-config
# Calagopus Wings host. Rendered by OpenTofu (terraform/wings/main.tf) and
# applied once, on first boot.
hostname: ${hostname}
manage_etc_hosts: true
timezone: Etc/UTC

# Key-only SSH as ewatkins; no default `ubuntu` user, no root login, no
# passwords. Host keys are generated fresh, so every wing has its own.
users:
  - name: ewatkins
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_key}
disable_root: true
ssh_pwauth: false

# Wings looks its user up by name (`system.username`, Calagopus's default
# `calagopus`) and runs every server container as it. Every wing's game data
# is owned by 999:987, so pinning the same ids keeps data copied from another
# wing owned correctly. Runs before any package can claim the ids.
bootcmd:
  - [sh, -c, "getent group calagopus >/dev/null || groupadd --system --gid 987 calagopus"]
  - [sh, -c, "getent passwd calagopus >/dev/null || useradd --system --uid 999 --gid 987 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin calagopus"]

apt:
  sources:
    docker.list:
      source: "deb [arch=amd64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
%{ if ship_logs ~}
    grafana.list:
      source: "deb [signed-by=$KEY_FILE] https://apt.grafana.com stable main"
      keyid: B53AE77BADB630A683046005963FA27710458545
%{ endif ~}

package_update: true
package_upgrade: true
packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - qemu-guest-agent
  - unattended-upgrades
  - curl
  - openssl
  # Migration: the rsync from the old wing, and gratuitous ARP when the
  # service addresses move over.
  - rsync
  - iputils-arping
%{ if bluemap ~}
  - nfs-common
%{ endif ~}
%{ if ship_logs ~}
  - alloy
%{ endif ~}

write_files:
  # Written before the packages are installed, so it applies to them too.
  - path: /etc/apt/apt.conf.d/99-no-recommends
    content: |
      APT::Install-Recommends "false";
      APT::Install-Suggests "false";

  # Daily unattended upgrades. Ubuntu's defaults take security updates only
  # and never reboot (a reboot stops the game server); Docker's repository is
  # not an allowed origin, so Docker is upgraded by hand.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  - path: /etc/ssh/sshd_config.d/10-wings.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowUsers ewatkins
      X11Forwarding no
      MaxAuthTries 3

  # live-restore keeps game servers running through a Docker upgrade.
  - path: /etc/docker/daemon.json
    content: |
      {
        "live-restore": true,
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }

  # The unit `wings service-install` would write. Enabled below but not
  # started: the node's config.yml arrives at cutover.
  - path: /etc/systemd/system/wings.service
    content: |
      [Unit]
      Description=Calagopus Wings Daemon
      After=docker.service
      Requires=docker.service
      PartOf=docker.service

      [Service]
      User=root
      KillMode=process
      LimitNOFILE=4096
      PIDFile=/run/calagopus-wings/daemon.pid
      ExecStart=/usr/local/bin/wings
      Restart=on-failure
      StartLimitInterval=180
      StartLimitBurst=30
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target

%{ if length(service_addresses) > 0 ~}
  # The old wing's addresses. Disabled by the suffix until the old VM is
  # off; WINGS.md renames it and runs `netplan apply`. eth0 is the name
  # cloud-init gives the NIC, so netplan merges these into its config.
  - path: /etc/netplan/60-service-addresses.yaml.cutover
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth0:
            addresses:
%{ for address in service_addresses ~}
              - ${address}/24
%{ endfor ~}
%{ endif ~}
%{ if second_nic != null ~}

  # A second NIC on the same /24 (eth1, ${second_nic.address}). Without
  # this, Linux answers ARP for either address on either NIC and sends every
  # reply out eth0, so the second address would show up under eth0's MAC.
  # rp_filter stays loose: eth1's traffic arrives on eth1 but its source is
  # routed via eth0 in the main table.
  - path: /etc/sysctl.d/60-second-nic.conf
    content: |
      net.ipv4.conf.all.arp_ignore = 1
      net.ipv4.conf.all.arp_announce = 2
      net.ipv4.conf.all.rp_filter = 2
      net.ipv4.conf.default.rp_filter = 2

  # eth1's own routing table (2): anything sent from its address, or marked
  # as part of a connection that came in on it, leaves by eth1.
  - path: /etc/netplan/70-second-nic.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth1:
            routes:
              - to: 192.168.50.0/24
                scope: link
                table: 2
              - to: default
                via: ${gateway}
                table: 2
            routing-policy:
              # Docker's own networks always use the main table. Velocity
              # reaches the Lobby through docker-proxy on this address, and
              # its replies to the Velocity container must stay on the host
              # instead of following table 2 out to the gateway.
              - to: 172.16.0.0/12
                table: 254
                priority: 100
              - from: ${second_nic.address}
                table: 2
              # netplan rejects a rule without `from` or `to`.
              - from: 0.0.0.0/0
                mark: 2
                table: 2

  # Game servers are Docker containers, so their replies are forwarded with
  # the container's source address and only become ${second_nic.address}
  # on the way out: the `from` rule above never sees them. Mark connections
  # that arrive on eth1 and route their replies by the mark instead. Packets
  # arriving on eth1 itself are left unmarked, so they still reach the
  # container through the main table.
  - path: /etc/systemd/system/second-nic-connmark.service
    content: |
      [Unit]
      Description=Route replies to eth1's connections back out eth1
      Before=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=true
      ExecStart=/bin/sh -c 'iptables -t mangle -C PREROUTING -i eth1 -m conntrack --ctstate NEW -j CONNMARK --set-mark 2 2>/dev/null || iptables -t mangle -A PREROUTING -i eth1 -m conntrack --ctstate NEW -j CONNMARK --set-mark 2'
      ExecStart=/bin/sh -c 'iptables -t mangle -C PREROUTING ! -i eth1 -m connmark --mark 2 -j MARK --set-mark 2 2>/dev/null || iptables -t mangle -A PREROUTING ! -i eth1 -m connmark --mark 2 -j MARK --set-mark 2'

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ if velocity_firewall != null ~}

  # Velocity (${velocity_firewall.address}:25565) takes new connections only
  # from the sources listed in terraform/wings. Docker-published ports skip
  # INPUT, so this sits in DOCKER-USER, matched on the pre-DNAT destination.
  - path: /usr/local/sbin/velocity-fw.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -e
      iptables -N VELOCITY-IN 2>/dev/null || iptables -F VELOCITY-IN
%{ for source in velocity_firewall.sources ~}
      iptables -A VELOCITY-IN -s ${source} -j RETURN
%{ endfor ~}
      iptables -A VELOCITY-IN -j DROP
      iptables -C DOCKER-USER -p tcp -m conntrack --ctstate NEW --ctorigdst ${velocity_firewall.address} --ctorigdstport 25565 -j VELOCITY-IN 2>/dev/null \
        || iptables -I DOCKER-USER -p tcp -m conntrack --ctstate NEW --ctorigdst ${velocity_firewall.address} --ctorigdstport 25565 -j VELOCITY-IN
  - path: /etc/systemd/system/velocity-fw.service
    content: |
      [Unit]
      Description=Restrict Velocity (25565) to the relay and the cluster
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/velocity-fw.sh

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ if ship_logs ~}

  # Alloy ships the game servers' logs to Loki in the cluster, through the
  # push-only route on the internal gateway. Velocity's logins and logouts
  # feed the Grafana Minecraft relay dashboard. Deferred until after the
  # package is installed, so dpkg doesn't see a clashing config file.
  - path: /etc/alloy/config.alloy
    defer: true
    content: |
      local.file_match "servers" {
        path_targets = [{
          __path__ = "/var/lib/calagopus-wings/volumes/*/logs/latest.log",
          job      = "minecraft",
          host     = "${hostname}",
        }]
      }

      loki.source.file "servers" {
        targets    = local.file_match.servers.targets
        forward_to = [loki.write.cluster.receiver]
        // Lines carry only a time of day, so stamp them as they are read
        // rather than backfilling old ones with the wrong time.
        tail_from_end = true
      }

      loki.write "cluster" {
        endpoint {
          url = "https://loki.ewatkins.dev/loki/api/v1/push"
        }
      }
  # The volumes directory is root-only; let Alloy read (not write) it.
  - path: /etc/systemd/system/alloy.service.d/10-read-server-logs.conf
    content: |
      [Service]
      AmbientCapabilities=CAP_DAC_READ_SEARCH
%{ endif ~}

runcmd:
  # Pinned and checksummed; a mismatch fails cloud-init visibly.
  - [sh, -c, "curl -fsSL -o /usr/local/bin/wings https://github.com/calagopus/wings/releases/download/${wings_version}/wings-rs-x86_64-linux && echo '${wings_sha256}  /usr/local/bin/wings' | sha256sum -c - && chmod 0755 /usr/local/bin/wings"]
  # Wings serves its API over TLS. Only Envoy talks to it, and Envoy skips
  # verification on this hop, so a self-signed cert does the job without
  # certbot or a Cloudflare token on the VM.
  - [sh, -c, "mkdir -p /etc/calagopus-wings/tls && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 -subj '/CN=${hostname}.ewatkins.dev' -addext 'subjectAltName=DNS:${hostname}.ewatkins.dev' -keyout /etc/calagopus-wings/tls/key.pem -out /etc/calagopus-wings/tls/cert.pem && chmod 0600 /etc/calagopus-wings/tls/key.pem"]
%{ if bluemap ~}
  - [systemctl, mask, --now, rpcbind.service, rpcbind.socket]
  # Shared BlueMap storage. Mounted here rather than with the `mounts`
  # module, which runs before packages are installed, so there is no NFS
  # helper yet. NFSv4.2 needs no rpcbind.
  - [sh, -c, "grep -q ' /mnt/bluemap ' /etc/fstab || echo 'storage.ewatkins.dev:/mnt/user/bluemap /mnt/bluemap nfs4 rw,hard,vers=4.2,timeo=600,retrans=2,_netdev,nofail 0 0' >> /etc/fstab; mkdir -p /mnt/bluemap && mount /mnt/bluemap"]
%{ endif ~}
%{ if second_nic != null ~}
  # Files written above only take effect on the next boot otherwise.
  - [sysctl, --system]
  - [netplan, apply]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, second-nic-connmark]
%{ endif ~}
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, restart, ssh]
  - [systemctl, daemon-reload]
  - [systemctl, enable, wings]
%{ if velocity_firewall != null ~}
  - [systemctl, enable, velocity-fw]
%{ endif ~}
%{ if ship_logs ~}
  - [systemctl, enable, alloy]
  - [systemctl, restart, alloy]
%{ endif ~}
